# ─────────────────────────────────────────────────────────────────────────────
#  Smotri server config. Copy to .env and fill in ONE key — that's enough.
#  (./setup.sh does this for you.)
# ─────────────────────────────────────────────────────────────────────────────

# Alibaba Cloud Model Studio (DashScope, international) key: speech-to-text,
# text-to-speech and vision. Get it: https://modelstudio.console.alibabacloud.com
DASHSCOPE_API_KEY=

# ── Brain (the LLM that talks and calls tools) ───────────────────────────────
# Any OpenAI-compatible endpoint with tool calling works.
#
# Profile A (default): everything on the one DashScope key above.
# qwen3-max passed the full voice test (tools, vision, memory, weather, music).
# qwen-flash is faster but did NOT call tools reliably (it made up places and "played"
# music without starting it). qwen-plus is cheaper and should work but is untested.
BRAIN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
BRAIN_MODEL=qwen3-max
VISION_MODE=describe
#
# Profile B: DeepSeek brain + direct vision (what the author runs; fastest, smartest)
# BRAIN_BASE_URL=https://api.deepseek.com
# BRAIN_MODEL=deepseek-v4-flash
# BRAIN_VISION_MODEL=deepseek-v4-flash-vision-exp
# BRAIN_API_KEY=sk-...
# VISION_MODE=direct
#
# Profile C: anything via OpenRouter (Claude, GPT, Gemini, Llama...)
# BRAIN_BASE_URL=https://openrouter.ai/api/v1
# BRAIN_MODEL=anthropic/claude-sonnet-4.5
# BRAIN_VISION_MODEL=anthropic/claude-sonnet-4.5
# BRAIN_API_KEY=sk-or-...
# VISION_MODE=direct
#
# Profile D: local model (vLLM / Ollama / LM Studio), e.g.
# BRAIN_BASE_URL=http://host.docker.internal:11434/v1
# BRAIN_MODEL=qwen3:14b
# BRAIN_API_KEY=ollama

# ── Access ───────────────────────────────────────────────────────────────────
# The app connects with ws://<host>:8000/ws?token=<SMOTRI_TOKEN>.
# Leave empty: a random token is generated on first start (data/access_token)
# and the full connection string is printed in the logs.
SMOTRI_TOKEN=
# Optional: your public address, so the logs print a ready-to-paste link.
# PUBLIC_URL=ws://203.0.113.7:8000

# ── Optional extras ──────────────────────────────────────────────────────────
# (Keep comments on their own lines: values are read up to the end of the line.)
#
# Language. The agent answers in the language you speak to it. STT auto-detects
# when empty; TTS picks English or Russian per turn when empty. Force them with
# e.g. QWEN_ASR_LANGUAGE=en and QWEN_TTS_LANGUAGE=English (Auto mangles short phrases).
QWEN_ASR_LANGUAGE=
QWEN_TTS_LANGUAGE=
QWEN_TTS_VOICE=Ethan
# Your timezone: the agent knows the local date and time (what's open, morning/evening).
AGENT_TIMEZONE=UTC
DASHSCOPE_WS_URL=wss://dashscope-intl.aliyuncs.com/api-ws/v1/inference/
DASHSCOPE_COMPAT_BASE=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
VISION_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen3-vl-plus
# Radio: prefer stations from these countries / in this language (phones often can't
# reach far-away streams). Example: RADIO_COUNTRIES=US,GB  RADIO_LANGUAGE=english
RADIO_COUNTRIES=
RADIO_LANGUAGE=
#
# Better place search for find_place (without it the agent uses web search):
# YANDEX_API_KEY=
# MAPS_LANG=en_US
# Alternative TTS voice (tts_engine: google in config.yaml):
# GEMINI_API_KEY=
# play_track from your Yandex Music account:
# YANDEX_MUSIC_TOKEN=
# HTTP proxy for radio/Gemini if your region needs one:
# AUDIO_PROXY=

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
MEMORY_DIR=/app/data/memory
